{
  "expo": {
    "name": "Anemia Screening",
    "slug": "anemia-screening-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "anemia-screening",
    "splash": {
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photo library to select conjunctiva images for anemia screening."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-asset",
      "expo-router"
    ]
  }
}
